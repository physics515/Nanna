/// Thinking mode for the agent loop
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
pub enum ThinkingMode {
    /// No explicit thinking — fast responses.
    ///
    /// INTERNAL ONLY. No config, IPC command, or UI control selects this;
    /// it's the fallback when no budget is specified.
    Instant,
    /// Low thinking budget (1024 tokens) — the API minimum.
    Low,
    /// Medium thinking budget (4096 tokens). **The default.**
    #[default]
    Medium,
    /// High thinking budget (8192 tokens).
    High,
    /// Maximum thinking budget (16384 tokens).
    Maximum,
}

impl ThinkingMode {
    /// Get the thinking budget in tokens for this mode
    #[must_use]
    pub const fn budget_tokens(&self) -> Option<u32> {
        match self {
            Self::Instant => None,
            Self::Low => Some(1024),
            Self::Medium => Some(4096),
            Self::High => Some(8192),
            Self::Maximum => Some(16384),
        }
    }

    /// Get the thinking budget in tokens for this mode (unwrap default)
    #[must_use]
    pub const fn budget_tokens_unwrap(&self) -> u32 {
        self.budget_tokens().unwrap_or(4096)
    }
}

/// Agent configuration
#[derive(Debug, Clone)]
pub struct AgentConfig {
    /// Model to use (primary / most capable model)
    pub model: String,
    /// Maximum tokens in response
    pub max_tokens: Option<u32>,
    /// Temperature for sampling
    pub temperature: Option<f32>,
    /// System prompt override
    pub system_prompt: Option<String>,
}

impl Default for AgentConfig {
    fn default() -> Self {
        Self {
            model: "qwen3.5:9b".to_string(),
            max_tokens: Some(4096),
            temperature: Some(0.7),
            system_prompt: None,
        }
    }
}

/// A model with its maximum complexity tier for routing purposes.
#[derive(Debug, Clone)]
pub struct ModelTier {
    /// Full model spec (may include provider prefix e.g. "ollama/deepseek-r1:14b")
    pub model: String,
    /// Maximum complexity this model should handle
    pub max_complexity: TaskComplexity,
}

/// Task complexity level for model routing decisions.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
pub enum TaskComplexity {
    /// Direct tool calls, simple Q&A, acknowledgments
    Simple = 0,
    /// Multi-step reasoning, code generation, summarization
    Medium = 1,
    /// Complex multi-agent coordination, planning, long-horizon tasks
    Complex = 2,
}

/// Options for running the agent
#[derive(Default)]
pub struct RunOptions {
    /// Override max iterations for this run
    pub max_iterations: Option<usize>,
    /// Additional context to prepend
    pub context: Option<String>,
    /// Thinking mode for this run
    pub thinking_mode: ThinkingMode,
}

/// Response from an agent run
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct AgentResponse {
    /// Final text response
    pub text: String,
    /// Tool calls made during this run
    pub tool_calls: Vec<ToolCallRecord>,
    /// Total iterations
    pub iterations: usize,
}

/// Reasoning content from thinking mode
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ReasoningContent {
    /// The full reasoning/thinking text
    pub content: String,
    /// Reasoning tokens used
    pub tokens_used: Option<u32>,
}

/// A single reasoning block (interleaved between actions)
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ReasoningBlock {
    /// The reasoning text for this block
    pub content: String,
    /// Which iteration this occurred in
    pub iteration: usize,
}

/// Emotional context detected in the conversation
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct EmotionalContext {
    /// Primary emotion (e.g., "neutral", "frustrated", "excited", "confused")
    pub primary_emotion: String,
    /// Intensity (0.0-1.0)
    pub intensity: f32,
}

/// Record of a tool call
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ToolCallRecord {
    pub id: String,
    pub name: String,
    pub input: serde_json::Value,
    pub result: Option<serde_json::Value>,
    pub success: bool,
}

/// Escalating firmness of a wrap-up nudge. The nudge only *steers* a long-running
/// (possibly stuck) agent — it never stops the loop.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum NudgeLevel {
    /// First, gentle: keep going if progressing, else pause and answer.
    Gentle,
    /// Firmer: consider wrapping up with a progress report.
    Moderate,
    /// Firm: wrap up with a summary unless clear progress is being made.
    Firm,
    /// Very firm: wrap up immediately regardless of progress.
    VeryFirm,
}

impl NudgeLevel {
    /// Get the description for this nudge level
    #[must_use]
    pub const fn description(&self) -> &'static str {
        match self {
            Self::Gentle => "gentle",
            Self::Moderate => "moderate",
            Self::Firm => "firm",
            Self::VeryFirm => "very firm",
        }
    }
}

/// Memory provenance: where did this memory come from?
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "lowercase")]
pub enum MemoryProvenance {
    Stated,
    Observed,
}

/// A memory extracted from conversation
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ExtractedMemory {
    pub content: String,
    pub category: String,
    pub provenance: MemoryProvenance,
}
//! Agent-related types extracted from loop_runner.rs

use serde::{Deserialize, Serialize};
use std::collections::HashMap;
use std::sync::Arc;
use tokio::sync::RwLock;

/// Thinking mode for the agent
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
pub enum ThinkingMode {
    /// No explicit thinking — fast responses.
    #[default]
    None,
    /// Explicit reasoning with interleaved blocks.
    Reasoning,
}

/// Agent configuration
#[derive(Debug, Clone)]
pub struct AgentConfig {
    /// Model to use (primary / most capable model)
    pub model: String,
    /// Maximum complexity tier for this agent
    pub max_tier: u8,
    /// Whether to enable tool use
    pub tools_enabled: bool,
}

/// A model with its maximum complexity tier for routing purposes.
#[derive(Debug, Clone)]
pub struct ModelTier {
    /// Full model spec (may include provider prefix e.g. "ollama/deepseek-r1:14b")
    pub model: String,
    /// Maximum complexity level this model can handle
    pub max_complexity: u8,
}

/// Task complexity level for model routing decisions.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
pub enum TaskComplexity {
    /// Direct tool calls, simple Q&A, acknowledgments
    Simple = 0,
    /// Multi-step reasoning with some tool use
    Medium = 1,
    /// Complex multi-agent coordination
    Hard = 2,
}

/// Options for running the agent
#[derive(Default)]
pub struct RunOptions {
    /// Override max iterations for this run
    pub max_iterations: Option<usize>,
    /// Whether to enable verbose logging
    pub verbose: bool,
}

/// Kind of step in the agent loop
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum StepKind {
    /// Decomposing or re-planning a task — route to the most capable tier.
    Plan,
    /// Executing tools or actions
    Act,
    /// Thinking/reasoning step
    Think,
}

/// Response from an agent run
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct AgentResponse {
    /// Final text response
    pub text: String,
    /// Tool calls made during the run
    pub tool_calls: Vec<ToolCallRecord>,
    /// Whether the run completed successfully
    pub success: bool,
}

/// Reasoning content from thinking mode
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ReasoningContent {
    /// The full reasoning/thinking text
    pub content: String,
}

/// A single reasoning block (interleaved between actions)
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ReasoningBlock {
    /// The reasoning text for this block
    pub content: String,
    /// Whether this is the final block
    pub is_final: bool,
}

/// Emotional context detected in the conversation
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct EmotionalContext {
    /// Primary emotion (e.g., "neutral", "frustrated", "excited", "confused")
    pub primary_emotion: String,
    /// Confidence in the detection
    pub confidence: f32,
}

/// Record of a tool call
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ToolCallRecord {
    pub id: String,
    pub name: String,
    pub input: serde_json::Value,
    pub output: String,
    pub success: bool,
    pub duration_ms: u64,
}

/// Memory provenance source
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "lowercase")]
pub enum MemoryProvenance {
    Stated,
    Observed,
}

/// A memory extracted from conversation
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ExtractedMemory {
    pub content: String,
    pub category: String,
    pub provenance: MemoryProvenance,
}

/// Repeat call state for rate limiting
#[derive(Debug, Default)]
pub struct RepeatLedger {
    inner: RwLock<HashMap<String, RepeatCallState>>,
    /// World epoch: how many successful side-effectful calls
    pub world_epoch: u64,
}

/// State for a single repeated call
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct RepeatCallState {
    /// How many times this has been called in the current run
    pub count: u32,
    /// Last time it was called (in world epoch)
    pub last_called: u64,
}

/// Nudge level for stuck agents
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum NudgeLevel {
    /// First, gentle: keep going if progressing, else pause and answer.
    Gentle,
    /// Medium: inject a nudge prompt to break loops.
    Medium,
    /// Hard: force a reset or hard stop.
    Hard,
}

/// Record of a tool call (extracted from loop_runner.rs)
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ToolCallRecord {
    pub id: String,
    pub name: String,
    pub input: Value,
    pub output: String,
    pub success: bool,
    pub duration_ms: u64,
}
